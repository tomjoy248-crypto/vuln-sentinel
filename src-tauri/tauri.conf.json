{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vuln Sentinel",
  "version": "11.0.3",
  "identifier": "com.tomjoy248.vulnsentinel",
  "build": {
    "beforeDevCommand": "npm --prefix ../frontend run dev",
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "title": "Vuln Sentinel 安全体检",
        "width": 1400,
        "height": 920,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": ["../runtime/backend-dist/vuln-sentinel-backend.exe"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "useLocalToolsDir": true
  }
}



