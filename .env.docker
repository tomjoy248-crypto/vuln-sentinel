# 漏洞哨兵 11-S - Docker 测试环境配置
# 用法：docker compose -f docker-compose.yml --env-file .env.docker up --build
#
# 与 .env 的区别：
#   - ENV=development（启用开发模式 CORS 自动补全）
#   - REDIS_URL 已配置（Docker Compose 内含 Redis）
#   - JWT_SECRET 使用随机值（测试用，生产请更换）

# 基础环境（测试用开发模式，CORS 更宽松）
ENV=development
HOST=0.0.0.0
PORT=8000

# JWT（测试环境使用固定值，生产环境必须随机生成）
JWT_SECRET=docker-test-secret-key-for-testing-only-32chars
JWT_EXPIRE_SECONDS=86400

# CORS（开发模式会自动补全本地端口；生产环境需显式配置域名）
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# 数据库
DB_DIR=/data
DB_NAME=scans.db

# Redis（Docker Compose 内含 Redis 服务）
REDIS_URL=redis://redis:6379/0

# 日志
LOG_LEVEL=INFO
ENABLE_STRUCTLOG=1

# 扫描策略
SCAN_TIMEOUT=12
MAX_CRAWL_PAGES=8
PUBLIC_DEMO_ENABLED=1
FREE_TRIAL_ENABLED=1

# 限流
RATE_LIMIT_GLOBAL_PER_MINUTE=30
RATE_LIMIT_SCAN_PER_MINUTE=10
RATE_LIMIT_FIX_PER_MINUTE=10

# 巡检
PATROL_INTERVAL_HOURS=6
PATROL_SCORE_REGRESSION_THRESHOLD=10

# 计费
PUBLIC_BASE_URL=http://localhost:8000

# LLM
LLM_ENABLED=0

# TLS
TLS_VERIFY=1

# 数据保留
DATA_RETENTION_SCANS_DAYS=90
DATA_RETENTION_AUDIT_LOGS_DAYS=180
DATA_RETENTION_USAGE_LOGS_DAYS=60

# 备份
BACKUP_DIR=/data/backups
BACKUP_RETENTION_COUNT=30

# 邮箱
EMAIL_VERIFICATION_REQUIRED=0
PASSWORD_RESET_ENABLED=1

# API 文档（测试环境可开启）
DISABLE_API_DOCS=0
